# Generated at build time by `src/main.py --make-icon`; the repository carries the
# one PyInstaller embeds, so a stray copy under src/ must never be committed.
/src/*.ico

# Build output and staging (release/<version>/ is rebuildable from a tag)
/.cache/
/build/
/out/
/release/

# PyInstaller leftovers
*.spec

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local configuration and credentials. config.json holds this machine's paths
# and targets; the release folder gets a template generated by
# make_release_config.py instead.
/config.json
/config.json.bak-*
/.env
/.env.*
!.env.example

# Logs. Everything the app and the test suites write lands under /log/ now:
#   log/reme-helper.log   the app's own log (rotated: .1 ... .3, 1 MB each)
#   log/<check>.log       one file per diagnostic: smoke / ui-check / release / lang-audit
#   log/tests/*.log       one file per test suite
/log/
*.log
/i18n_review.md

# Operating-system metadata
.DS_Store
Thumbs.db
desktop.ini
